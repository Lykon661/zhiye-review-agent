# Optional legacy model defaults. Prefer the web UI model settings; saved UI settings take precedence.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90
# Uses the pinned FP32 ONNX export of BGE Small; runtime is CPU-only.
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_LOCAL_FILES_ONLY=false
DATA_DIR=./data
HF_HOME=./.cache/huggingface
RETRIEVAL_MIN_SCORE=0.38
OCR_ENABLED=true
FORMULA_OCR_ENABLED=true
OCR_MIN_CONFIDENCE=0.65
OCR_MAX_IMAGE_PIXELS=12000000
BACKEND_PORT=8000
# Optional paths; defaults use .runtime/tika/tika-app-3.3.2.jar and Java on PATH/JAVA_HOME.
TIKA_APP_JAR=
TIKA_JAVA=
